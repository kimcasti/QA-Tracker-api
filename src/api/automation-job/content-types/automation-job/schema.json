{
  "kind": "collectionType",
  "collectionName": "automation_jobs",
  "info": {
    "singularName": "automation-job",
    "pluralName": "automation-jobs",
    "displayName": "automation-job"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "runnerId": {
      "type": "integer",
      "required": true
    },
    "projectId": {
      "type": "string",
      "required": true
    },
    "runId": {
      "type": "string",
      "required": true
    },
    "requestedBy": {
      "type": "integer",
      "required": true,
      "private": true
    },
    "requestKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "activeRun": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "activeRunner": {
      "type": "integer",
      "unique": true,
      "private": true
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "pending",
        "running",
        "completed",
        "interrupted"
      ],
      "required": true
    },
    "cases": {
      "type": "json",
      "required": true
    },
    "catalogHash": {
      "type": "string",
      "required": true
    },
    "completedCount": {
      "type": "integer",
      "default": 0
    },
    "message": {
      "type": "text"
    },
    "startedAt": {
      "type": "datetime"
    },
    "finishedAt": {
      "type": "datetime"
    },
    "receiptHash": {
      "type": "string",
      "private": true
    },
    "outcomes": {
      "type": "json"
    }
  }
}
