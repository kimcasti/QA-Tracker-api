NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Strapi secrets
APP_KEYS=changeMeAppKey1,changeMeAppKey2,changeMeAppKey3,changeMeAppKey4
API_TOKEN_SALT=changeMeApiTokenSalt
ADMIN_JWT_SECRET=changeMeAdminJwtSecret
TRANSFER_TOKEN_SALT=changeMeTransferTokenSalt
JWT_SECRET=changeMeJwtSecret
ENCRYPTION_KEY=changeMeEncryptionKey

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=qa-tracker
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_KEY=
DATABASE_SSL_CERT=
DATABASE_SSL_CA=
DATABASE_SSL_CAPATH=
DATABASE_SSL_CIPHER=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT=60000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Frontend / CORS
CLIENT_URLS=http://localhost:3000
INVITATION_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:1337
APP_URL=http://localhost:3000

# Initial bootstrap data
INITIAL_ORGANIZATION_NAME=QA Tracker Demo
INITIAL_ORGANIZATION_SLUG=qa-tracker-demo
INITIAL_ORGANIZATION_PLAN=starter
INITIAL_USER_EMAIL=admin@qatracker.local
INITIAL_USER_USERNAME=admin
INITIAL_USER_PASSWORD=ChangeMe123!
INITIAL_USER_IS_SUPERADMIN=false
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Optional integrations
SLACK_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model override. Must be available to the configured Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# Email / invitations
MAIL_FROM="QA Tracker <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=15000

# Mailtrap API is recommended in production environments like Railway.
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send

# Optional mail branding override for the QA Tracker header logo.
MAIL_BRAND_LOGO_URL=
# Jira: local account connection. Keep writes disabled until the test is approved.
# Required for tokens saved through the UI: 32 random bytes encoded as base64.
# Server-only. Preserve this key across deployments and database restores.
JIRA_CREDENTIALS_ENCRYPTION_KEY=
# OAuth app registered in the Atlassian developer console (server only).
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:3000/settings/integrations/jira/callback
JIRA_SITE_URL=https://digheontech.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_QA_USER_ID=
# Required only for scoped API tokens (Atlassian gateway).
JIRA_CLOUD_ID=
JIRA_ENABLE_WRITES=false
